# Copie para .env.production (valores públicos, podem ir para o git) para ativar o "Entrar com Instagram".
# ID do app do Instagram (painel da Meta > Configuração da API com login do Instagram)
VITE_INSTAGRAM_APP_ID=
# Endereço do servidor de login publicado com `npm run auth:deploy`
VITE_AUTH_API_URL=https://sorteio-instagram-auth.SEU-SUBDOMINIO.workers.dev
